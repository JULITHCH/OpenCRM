# Basis-URL der REST-API. Leer lassen fuer relative Pfade — im Dev-Modus proxied
# vite.config.ts alle /api-Aufrufe nach http://localhost:8080 (Backend ohne CORS).
# Nur fuer Produktions-Builds setzen, wenn die API auf einem anderen Origin liegt.
VITE_API_URL=

# Basis-URL des Keycloak-Servers (Realm "opencrm", Client "opencrm-web").
VITE_KEYCLOAK_URL=http://localhost:8081
