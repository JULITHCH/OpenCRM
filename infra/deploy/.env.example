# --- Oeffentliche URLs (hinter dem vorgelagerten Nginx-Proxy, HTTPS) -----------
# App und Keycloak als getrennte Subdomains. OHNE abschliessenden Slash.
CRM_PUBLIC_URL=https://crm.example.com
AUTH_PUBLIC_URL=https://auth.example.com

# --- Datenbank-Passwoerter (frei waehlen, stark) -------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
OPENCRM_DB_APP_PASSWORD=change-me-app
OPENCRM_DB_MIGRATOR_PASSWORD=change-me-migrator
KEYCLOAK_DB_PASSWORD=change-me-kc-db

# --- Keycloak ------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
# Secret des Service-Clients opencrm-api (Maschinenzugriffe). Stark waehlen.
OPENCRM_API_CLIENT_SECRET=change-me-api-secret

# --- Build-Metadaten (optional) ------------------------------------------------
# Commit-Stand fuer den Footer; z. B. mit `git rev-parse --short=10 HEAD` fuellen.
OPENCRM_GIT_SHA=release
